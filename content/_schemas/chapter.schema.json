{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./chapter.schema.json",
  "title": "Chapter",
  "description": "Extended front-matter for a WayFare chapter markdown file.",
  "type": "object",
  "required": ["id", "title", "season", "day_or_night", "kind"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable slug used as a cross-reference target."
    },
    "title": {
      "type": "string"
    },
    "season": {
      "type": "string",
      "enum": ["always", "winter", "spring", "summer", "autumn"]
    },
    "day_or_night": {
      "type": "string",
      "enum": ["day", "night", "either"]
    },
    "kind": {
      "type": "string",
      "enum": ["sky", "land"]
    },
    "cultures": {
      "type": "array",
      "items": { "$ref": "#/$defs/culture" },
      "uniqueItems": true
    },
    "themes": {
      "type": "array",
      "items": { "$ref": "#/$defs/theme" },
      "uniqueItems": true
    },
    "unlock": {
      "type": "object",
      "description": "Kept as-is; the existing unlock resolver in app/src/lib/unlock.ts consumes this without changes."
    },
    "related_sky_objects": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "related_ground_objects": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "suggested_experiments": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "follow_up_quests": {
      "type": "array",
      "description": "Structured 'Tomorrow's Quest' items: typically one sky/night thing, one ground/daylight thing, and one word or story-hook to carry forward.",
      "items": { "$ref": "#/$defs/follow_up_quest" }
    },
    "body_path": {
      "type": "string",
      "description": "Relative path to the markdown body. Defaults to the file containing this front-matter."
    },
    "source_links": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_link" }
    }
  },
  "$defs": {
    "culture": {
      "type": "string",
      "enum": [
        "greek", "latin", "egyptian", "arabic", "persian", "babylonian",
        "norse", "celtic", "welsh", "irish", "scots", "english-folk", "british-folk",
        "chinese", "japanese", "korean",
        "hindustani", "sanskrit",
        "polynesian", "hawaiian", "māori",
        "aboriginal-australian", "yolŋu", "gamilaraay", "boorong",
        "inuit", "mi-kmaq", "abenaki", "cherokee",
        "sami", "san", "finnish", "baltic",
        "universal"
      ]
    },
    "theme": {
      "type": "string",
      "enum": [
        "science", "language", "folktale", "history", "instrument", "safety",
        "error-curriculum", "seasonal-clock", "wayfinding", "weather",
        "storytelling", "capstone"
      ]
    },
    "source_link": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string" },
        "cultures": {
          "type": "array",
          "items": { "$ref": "#/$defs/culture" },
          "uniqueItems": true
        }
      }
    },
    "follow_up_quest": {
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["sky", "ground", "story"],
          "description": "sky = an evening or sky-watch thing to find; ground = a daylight or land thing to try; story = a word, phrase or story-hook to carry forward."
        },
        "text": { "type": "string" },
        "auto_generated": {
          "type": "boolean",
          "description": "True if this quest was drafted by tooling and still needs human review. Tracked in quests-todo.md."
        }
      }
    }
  }
}

{
  "name": "wayfare-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The WayFare PWA — a rudely minimal companion to the paper Fieldbook.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
